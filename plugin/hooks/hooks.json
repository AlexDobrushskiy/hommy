{
  "description": "hommy: Telegram turns (hommy hook), agterm session status, WhatsApp and Telegram write guards",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/hommy-hook\" session-start", "timeout": 10 }] },
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wacli-guard\" session-start", "timeout": 5 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/hommy-hook\" user-prompt-submit", "timeout": 10 }] },
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/agterm-status\" active --blink", "timeout": 5 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/hommy-hook\" stop", "timeout": 10 }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/hommy-hook\" notify", "timeout": 10 }] },
      {
        "matcher": "permission_prompt",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/agterm-status\" blocked --blink", "timeout": 5 }]
      }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/agterm-status\" active --blink", "timeout": 5 }] }
    ],
    "PermissionRequest": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/agterm-status\" blocked --blink", "timeout": 5 }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/agterm-status\" idle", "timeout": 5 }] }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Monitor",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/wacli-guard\"", "timeout": 10 }]
      },
      {
        "matcher": "Bash|Monitor|Read|Edit|Write|MultiEdit|NotebookEdit|Grep|mcp__.*|PowerShell",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/telegram-guard\"", "timeout": 10 }]
      }
    ]
  }
}
