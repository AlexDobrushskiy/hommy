# hommy's third-party tools (install.sh stage 3: `brew bundle --file Brewfile --no-upgrade`). Each comes from its own
# source; nothing is vendored. `# check:` names what install.sh looks for to call an entry present (a command on PATH,
# or an .app in /Applications or ~/Applications).
tap "mostlygeek/llama-swap"
tap "umputun/apps"
brew "ffmpeg"                              # check: ffmpeg
brew "whisper.cpp"                         # check: whisper-server
brew "mostlygeek/llama-swap/llama-swap"    # check: llama-swap
brew "uv"                                  # check: uv
brew "node"                                # check: node
brew "git"                                 # check: git
cask "umputun/apps/agterm"                 # check: agterm.app
cask "google-chrome"                       # check: Google Chrome.app
